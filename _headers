/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 页面外壳与 manifest 必须每次校验（T3.9 · S3.5）。
# 它们是指针：一旦缓存旧值，页面就永远看不到新数据。
/data/manifest.json
  Cache-Control: no-store, must-revalidate

/manifest.json
  Cache-Control: no-store, must-revalidate

# 带内容哈希的数据文件：永久缓存（T3.9）。
# 文件名里的哈希就是内容指纹，内容一变文件名就变——不会拿到旧内容。
# 注意这条要写在具体路径规则之前，否则会被 /data.json 的规则抢走。
/data/data.*.json
  Cache-Control: public, max-age=31536000, immutable

/data/bench.*.json
  Cache-Control: public, max-age=31536000, immutable

/data/news-milestones.*.json
  Cache-Control: public, max-age=31536000, immutable

# 兼容层：页面旧路径仍可用，但只缓存 5 分钟（内容会随每次发布变）
/data.json
  Cache-Control: public, max-age=300

/bench.json
  Cache-Control: public, max-age=300

# 自托管字体与静态资源：文件名不带哈希，缓存一天
/assets/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
