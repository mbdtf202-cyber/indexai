{
  "name": "indexai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI 模型价格索引与情报站",
  "license": "MIT",
  "homepage": "https://indexai.pages.dev/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write lib test scripts site pipeline",
    "typecheck": "tsc --noEmit",
    "invariants": "node scripts/check-invariants.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/golden/**/*.test.js\" \"test/contract/**/*.test.js\"",
    "verify": "npm run lint && npm run typecheck && npm run invariants && npm test",
    "collect": "node collect.mjs",
    "record": "node --import ./test/support/http-record.js",
    "golden:update": "node scripts/update-golden.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
